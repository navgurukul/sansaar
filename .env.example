NODE_ENV="development"
PORT=6112

SEED_PORT=6112

## Database Related Stuff
DB_NAME="your_db_name"
DB_HOST="your_db_host"
DB_USER="your_db_user"
DB_PASS="your_db_password"
# DB_SSL_ENABLED=true (default: true, set to 'false' to disable SSL)
# DB_SSL_REJECT_UNAUTHORIZED=false (default: false for AWS RDS compatibility, set to 'true' for strict SSL validation)

## GPT CREDENTIALS
OPENAI_API_KEY=your_openai_key

# GOOGLE SHEETS CREDENTIALS
SHEET_ID="your_sheet_id"
SHEET_NAME="Reading"
SHEET_RANGE="E2:E10"
PRIVATE_KEY="your_private_key"
CLIENT_EMAIL="your_client_email"

## Google APIs
AUTH_JWT_SECRET="your_jwt_secret"
GOOGLE_AUTH_CLIENT_ID_WEB="your_client_id"
GOOGLE_AUTH_CLIENT_SECRET_WEB="your_client_secret"
GOOGLE_CONSENT_REDIRECT_URI="your_redirect_uri"
GOOGLE_CONSENT_REDIRECT_URI_PARTNER_DASHBOARD="your_partner_dashboard_uri"
GOOGLE_AUTH_CLIENT_ID_ANDROID="your_android_client_id"

## Google Translation
GOOGLE_TRANSLATION={"type": "service_account","project_id": "your_project"}

COURSE_SEEDING_ENDPOINT="your_endpoint"

## Chat
CHAT_ACCESS_TOKEN="your_chat_token"
CHAT_HOMESERVER_URL="your_homeserver_url"
CHAT_MERAKI_USER_ID="your_user_id"

## Bol DB Connection
