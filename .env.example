S3_SECRET_KEY_ID="your_s3_key_id"
S3_REGION="ap-south-1"
S3_BUCKET="your_bucket"
SCRATCH_BUCKET="your_scratch_bucket"

CRETENTIALS_TEMP_ACCESS_KEY="your_temp_access_key"
CRETENTIALS_TEMP_SECRET_KEY="your_temp_secret_key"
