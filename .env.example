BOL_DB_HOST="your_bol_db_host"
BOL_DB_USER="your_bol_db_user"
BOL_DB_PASS="your_bol_db_pass"

## MERAKI
MERAKI_AUTH_CLIENT_ID="your_meraki_client_id"
MERAKI_AUTH_CLIENT_SECRET="your_meraki_client_secret"
